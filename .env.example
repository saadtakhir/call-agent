# --- Auth (this app's own simple single-admin login) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Any long random string — used to sign the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Database (Neon Postgres recommended, but any Postgres works) ---
DATABASE_URL=
# Neon's unpooled/direct connection string — used by Prisma CLI (migrate/db push).
# If you don't have a separate unpooled URL, just repeat DATABASE_URL here.
DATABASE_URL_UNPOOLED=

# --- Vercel Blob (audio caching: greeting, canned responses, per-property replies) ---
BLOB_READ_WRITE_TOKEN=

# --- OpenAI (agent brain + default STT provider) ---
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# OPENAI_CALL_MODEL=gpt-5.6-terra

# --- ElevenLabs (TTS, and an alternative STT provider) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_CALL_MODEL_ID=eleven_v3_conversational

# --- Muxlisa AI (Uzbek-specialized alternative STT provider) ---
# MUXLISA_API_KEY=

# --- uy-joy.uz property catalog (defaults already point at the live site) ---
# UY_JOY_API_BASE=https://api.uy-joy.uz/api/public/product
# UY_JOY_CATALOG_URL=https://api.uy-joy.uz/api/public/main/catalog/search

# --- Telegram (optional — captured leads are forwarded here if set) ---
# TELEGRAM_BOT_TOKEN=
