generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppSetting {
  key   String @id
  value String
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  permissions  String[]
  createdAt    DateTime @default(now())
}

model LoginAttempt {
  // The attempted username, lowercased/trimmed — not a foreign key, since
  // this also has to track guesses against usernames (including the env
  // admin's) that aren't User rows at all.
  key         String    @id
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model PropertyLookupLog {
  id             Int      @id @default(autoincrement())
  search         String
  resolvedSearch String?
  regions        String?
  category       String?
  found          Boolean
  title          String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model PropertyLead {
  id         Int      @id @default(autoincrement())
  propertyId String
  name       String?
  phone      String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AiCallSession {
  sessionId      String   @id
  lastResponseId String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Per-call usage, accumulated turn by turn (see lib/callUsage.js) — the
  // basis for the real, per-minute cost averages shown on the Xarajatlar
  // panel, as opposed to ProviderUsagePanel's account-wide provider totals.
  sttSeconds      Float @default(0)
  llmInputTokens  Int   @default(0)
  llmCachedTokens Int   @default(0)
  llmOutputTokens Int   @default(0)
  ttsCharacters   Int   @default(0)

  @@index([active, updatedAt])
}

/** Generic fixed-window IP rate limiter (see lib/rateLimit.js) — currently
 * only guards /api/ai-call/start against a valid-but-malicious/compromised
 * account rapidly cycling start→end to churn through many calls despite
 * the concurrency cap, which only bounds calls active AT ONCE, not total
 * throughput over time. */
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model CannedResponse {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  text      String
  audioUrl  String?
  updatedAt DateTime @updatedAt
}

model PropertyReplyAudio {
  propertyId Int      @id
  textHash   String
  audioUrl   String
  updatedAt  DateTime @updatedAt
}
