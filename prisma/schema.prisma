generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppSetting {
  key   String @id
  value String
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  permissions  String[]
  createdAt    DateTime @default(now())
}

model LoginAttempt {
  // The attempted username, lowercased/trimmed — not a foreign key, since
  // this also has to track guesses against usernames (including the env
  // admin's) that aren't User rows at all.
  key         String    @id
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model PropertyLookupLog {
  id             Int      @id @default(autoincrement())
  search         String
  resolvedSearch String?
  regions        String?
  category       String?
  found          Boolean
  title          String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model PropertyLead {
  id         Int      @id @default(autoincrement())
  propertyId String
  name       String?
  phone      String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AiCallSession {
  sessionId      String   @id
  lastResponseId String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Set once, only when the call is actually determined to have ended
  // (endCallSession, or the opportunistic stale-session reaper) — NEVER
  // relies on `updatedAt` for this, since that gets touched by unrelated
  // later writes to the same row (Prisma's @updatedAt bumps it on ANY
  // update) and would otherwise silently inflate durationSeconds by
  // however long the row sat around before something next touched it.
  endedAt DateTime?

  // "widget" (browser) or "sip" (sip-bridge/Asterisk) — set once at
  // /api/ai-call/start and never changed, powers the Qo'ng'iroqlar tarixi
  // page's "Kanal" column.
  channel String @default("widget")

  // Whichever logged-in account's session cookie hit /api/ai-call/start —
  // for "widget" calls this is the real staff member who clicked
  // "Qo'ng'iroqni boshlash"; for "sip" calls it's just sip-bridge's own
  // service-account login (see sip-bridge/README.md), so it never
  // identifies the actual caller on a real phone call. Null for any row
  // created before this column existed.
  startedByUsername String?

  // Populated for "sip" calls — the dialplan packs CALLERID(num) in front
  // of AudioSocket's own "uuid" argument (see sip-bridge/README.md's
  // dialplan snippet and callSession.js's handleFrame), since that field
  // is just an opaque string Asterisk hands back verbatim, never actually
  // parsed as a real UUID. Null for any row from before this existed, or
  // if the caller's number itself was withheld/unavailable.
  callerNumber String?

  // Set by the "Tugatish" button on Faol suhbatlar (see
  // lib/aiCallCapacity.js's requestHangup) and polled by both the widget
  // and sip-bridge during an active call — there's no server-push
  // channel to either client, so polling is the only option.
  hangupRequested Boolean @default(false)

  // Per-call usage, accumulated turn by turn (see lib/callUsage.js) — the
  // basis for the real, per-minute cost averages shown on the Xarajatlar
  // panel, as opposed to ProviderUsagePanel's account-wide provider totals.
  sttSeconds      Float @default(0)
  llmInputTokens  Int   @default(0)
  llmCachedTokens Int   @default(0)
  llmOutputTokens Int   @default(0)
  ttsCharacters   Int   @default(0)

  @@index([active, updatedAt])
  @@index([createdAt])
}

/** Generic fixed-window IP rate limiter (see lib/rateLimit.js) — currently
 * only guards /api/ai-call/start against a valid-but-malicious/compromised
 * account rapidly cycling start→end to churn through many calls despite
 * the concurrency cap, which only bounds calls active AT ONCE, not total
 * throughput over time. */
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model CannedResponse {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  text      String
  audioUrl  String?
  updatedAt DateTime @updatedAt
}

model PropertyReplyAudio {
  propertyId Int      @id
  textHash   String
  audioUrl   String
  updatedAt  DateTime @updatedAt
}

/** One row per AI tool call (built-in or custom, see lib/aiTools.js) — powers
 * the per-tool call/error/latency stats on the Toollar settings tab. */
model ToolCallLog {
  id         Int      @id @default(autoincrement())
  toolName   String
  ok         Boolean
  durationMs Int
  error      String?
  createdAt  DateTime @default(now())

  @@index([toolName, createdAt])
  @@index([createdAt])
}
