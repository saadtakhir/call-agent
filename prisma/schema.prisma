generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppSetting {
  key   String @id
  value String
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  permissions  String[]
  createdAt    DateTime @default(now())
}

model LoginAttempt {
  // The attempted username, lowercased/trimmed — not a foreign key, since
  // this also has to track guesses against usernames (including the env
  // admin's) that aren't User rows at all.
  key         String    @id
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model PropertyLookupLog {
  id             Int      @id @default(autoincrement())
  search         String
  resolvedSearch String?
  regions        String?
  category       String?
  found          Boolean
  title          String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model PropertyLead {
  id         Int      @id @default(autoincrement())
  propertyId String
  name       String?
  phone      String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AiCallSession {
  sessionId      String   @id
  lastResponseId String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, updatedAt])
}

model CannedResponse {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  text      String
  audioUrl  String?
  updatedAt DateTime @updatedAt
}

model PropertyReplyAudio {
  propertyId Int      @id
  textHash   String
  audioUrl   String
  updatedAt  DateTime @updatedAt
}
