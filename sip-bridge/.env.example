# The deployed ai-call-agent app this bridge talks to — same endpoints
# components/AiCallWidget.jsx already calls from the browser.
APP_BASE_URL=https://call.saad.uz

# A dedicated login created on that app's Foydalanuvchilar page, with
# ONLY the "Suhbat" (view_call) permission — never a real admin account.
SIP_BRIDGE_USERNAME=
SIP_BRIDGE_PASSWORD=

# Local TCP port Asterisk's AudioSocket() dialplan app connects to —
# must match the port used in asterisk-config/extensions.conf.example.
AUDIOSOCKET_PORT=8090
